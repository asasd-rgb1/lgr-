{
  "name": "video-studio",
  "version": "1.0.0",
  "description": "Editable Chinese knowledge motion graphics studio",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts --port=3101",
    "still": "remotion still src/index.ts SineProjection renders/sine-keyframe.png --frame=60 --scale=0.5 --port=3101",
    "render:preview": "remotion render src/index.ts SineProjection renders/sine-preview-540p.mp4 --scale=0.5 --codec=h264 --pixel-format=yuv420p --color-space=bt709 --crf=23 --concurrency=2 --port=3101",
    "render:final": "remotion render src/index.ts SineProjection renders/sine-1080p.mp4 --codec=h264 --pixel-format=yuv420p --color-space=bt709 --crf=18 --concurrency=2 --port=3101",
    "render:60fps": "remotion render src/index.ts SineProjection60 renders/sine-1080p60.mp4 --codec=h264 --pixel-format=yuv420p --color-space=bt709 --crf=18 --concurrency=2 --port=3101",
    "ffmpeg": "node scripts/media-tool.mjs ffmpeg",
    "ffprobe": "node scripts/media-tool.mjs ffprobe",
    "verify:preview": "node scripts/verify-preview.mjs"
  }
}
